# Copy to .env and fill in real values. Never commit .env.

# Local Pact Broker (docker-compose.yml) — postgres backing store
POSTGRES_DB=pact_broker
POSTGRES_USER=pact_broker
POSTGRES_PASSWORD=pact_broker

# Pact Broker connection used by pact:publish / pact:can-i-deploy / pact:record-deployment.
# Defaults below match the local broker's basic-auth credentials in docker-compose.yml.
PACT_BROKER_BASE_URL=http://localhost:9292
PACT_BROKER_USERNAME=pact_broker
PACT_BROKER_PASSWORD=pact_broker
